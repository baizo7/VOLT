# Local development settings
POSTGRES_USER=observer
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=observer
DATABASE_URL=postgresql://observer:replace_with_secure_password@127.0.0.1:5432/observer
ROUTES_FILE=routes.json
MAX_STORED_CHARS=200000

# Optional authentication token for observer proxy and APIs
# Leave unset to disable authentication (backward compatible)
OBSERVER_AUTH_TOKEN=

# Add only the provider keys you actually use.
# Never commit real API keys.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
